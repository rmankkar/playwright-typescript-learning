# Playwright TypeScript Learning Framework - .gitignore
# ========================================================
# This file tells Git which files and folders to ignore.
# Anything listed here will NOT be tracked in version control.
#
# Why we ignore these:
# - node_modules: hundreds of packages, regenerated by `npm install`
# - test-results / playwright-report: regenerated on every test run
# - trace: trace files captured by Playwright, can be large
# - *.log / .env: may contain secrets or local-only data
# - .DS_Store: macOS folder metadata, not relevant to the project
# - coverage: code coverage reports, regenerated on demand
#
# Rule: Never commit generated artifacts, dependencies, or secrets.

# Dependencies -----------------------------------------------------------
node_modules/

# Playwright artifacts ---------------------------------------------------
test-results/
playwright-report/
trace/

# Logs and environment ---------------------------------------------------
*.log
.env

# macOS ------------------------------------------------------------------
.DS_Store

# Coverage (if we add a coverage tool later) -----------------------------
coverage/
.nyc_output/

# TypeScript build output ------------------------------------------------
dist/
build/
